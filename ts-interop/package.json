{
  "name": "microlens-ts-interop",
  "version": "0.1.0",
  "description": "Isolated TypeScript/Bun interop sidecar bridging the MicroLens Python/FastAPI/SQLite MVP to a hive-side Bun/Express/Prisma/PostgreSQL/Elasticsearch stack.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.1",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
