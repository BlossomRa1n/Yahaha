# Example environment for the MicroLens TypeScript/Bun interop sidecar.
# Copy this file to `.env` and fill in real values. NO real credentials are
# committed here — every value below is a local placeholder.

# Base URL of the upstream Python FastAPI service (read-through proxy target).
FASTAPI_URL=http://localhost:8000

# PostgreSQL connection string used by Prisma. PostgreSQL is an EXTERNAL
# service that this repository does NOT start or provision; it must already be
# running (and migrated via `bun run prisma:migrate`) for the write path.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/microlens?schema=public

# Elasticsearch cluster URL. Also an EXTERNAL service; must be running for the
# ingest write path. The read/health path degrades gracefully without it.
ELASTICSEARCH_URL=http://localhost:9200

# Port this sidecar listens on.
PORT=4000
