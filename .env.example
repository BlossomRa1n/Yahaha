APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
APP_DATABASE=data/app.db
MODEL_POINTER=artifacts/current.json
# Unified DSSM + multimodal retrieval and DeepFM ranking. Missing/invalid files
# automatically fall back to MODEL_POINTER. experiment-current.json is written by
# every training run; deep-current.json is only written when --publish passes the
# quality gate. Point here at deep-current.json to serve only published artifacts.
DEEP_MODEL_POINTER=artifacts/experiment-current.json
MULTIMODAL_MODEL_POINTER=artifacts/multimodal-current.json
SESSION_HOURS=12
SESSION_COOKIE=microlens_session
FEED_SNAPSHOT_TTL_MINUTES=60
FEED_SNAPSHOT_MAX_ITEMS=500
# Optional: threshold alerting window (minutes) and optional Redis cache URL.
# Leave REDIS_URL unset (or the redis package absent) to degrade to a no-op cache.
ALERT_WINDOW_MINUTES=60
# REDIS_URL=redis://127.0.0.1:6379/0
